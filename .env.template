# 复制为 .env 后填写；.env 不提交 Git。
# Docker Compose 会读取项目根目录的 .env；直接运行二进制需先导入环境变量。

# 启用 AI 聊天时填写，同时在 config.yaml 中启用 llm 配置。
DEEPSEEK_API_KEY=''

# Docker Compose 启动 PostgreSQL 必填；本地不使用数据库时可留空。
AICE_POSTGRES_PASSWORD=''

# Docker Compose 可选配置，取消注释后覆盖默认值。
# AICE_CONFIG_FILE='./config.yaml'
# SEALDICE_NETWORK='sealdice_sealdice_network'
# AICE_PUBLIC_PORT=80
# AICE_IMAGE_PREFIX='docker.io/library'
# AICE_CARGO_MIRROR='sparse+https://rsproxy.cn/index/'
# 如需使用 crates.io，将 AICE_CARGO_MIRROR 设置为空字符串。

# 直接运行二进制时的可选配置，不影响 Compose 中固定的容器配置。
# AICE_CONFIG_PATH='./config.yaml'
# AICE_BIND_ADDR='127.0.0.1:3210'

# 本地连接已有 PostgreSQL 时启用；未设置 PGHOST 则不连接数据库。
# Compose 的数据库连接由 docker-compose.yml 配置，无需填写下列变量。
# PGHOST='127.0.0.1'
# PGPORT=5432
# PGDATABASE='aice'
# PGUSER='aice'
# PGPASSWORD=''

# 模型名称、API 地址和公开下载根地址仍在 config.yaml 中配置。
